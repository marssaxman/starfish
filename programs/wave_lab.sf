starfish 1;
program "Wave laboratory" @id("wave-laboratory") {
    param rotation: Angle = 18deg in -180deg..180deg step 0.5deg;
    param frequency: Frequency = 3.2 in 0.2..12 step 0.05;
    param phase: Angle = 0deg in -180deg..180deg step 0.5deg;
    param overtones: Scalar = 0.7 in 0..1 step 0.01;
    param modulation: Scalar = 0.18 in 0..0.5 step 0.01;
    param pulse_width: Scalar = 0.32 in 0..1 step 0.01;
    param pulse_strength: Scalar = 0.2 in 0..0.8 step 0.01;
    param saw_strength: Scalar = 0.18 in 0..0.8 step 0.01;

    frame shared = rotate(world, rotation);
    axis horizontal = vec2(1, 0);
    axis crossing = rotate(horizontal, 72deg);
    field coordinate: Scalar = dot(shared, horizontal);
    field cross_coordinate: Scalar = dot(shared, crossing);
    field radius: Scalar = length(shared - point2(-0.28, 0.18));

    // Compare the four profiles on the same coordinate and frequency.
    field sine: Scalar = wave(coordinate, frequency, phase);
    field triangular: Scalar = triangle(coordinate, frequency, phase);
    field sawtooth: Scalar = saw(coordinate, frequency, phase);
    field pulses: Scalar = pulse(coordinate, frequency, phase, pulse_width);

    // Build richer signals using ordinary components and scalar arithmetic.
    component spectrum(c: Field<Scalar>, f: Frequency, p: Angle,
                       detail: Scalar) -> Field<Scalar> =
        0.7 * wave(c, f, p)
        + detail * (0.2 * wave(2 * c, f, p) + 0.1 * wave(3 * c, f, p));
    field harmonics: Scalar = spectrum(coordinate, frequency, phase, overtones);
    field modulator: Scalar = wave(cross_coordinate, 1.2cycles, phase);
    field modulated: Scalar =
        wave(coordinate + modulation * modulator, frequency, phase);
    field radial: Scalar = triangle(radius, frequency, phase);
    field composition: Scalar = tanh(
        0.65 * harmonics * modulated + 0.55 * radial
        + saw_strength * sawtooth + pulse_strength * pulses);

    palette ink = smooth [
        rgb(0.035, 0.055, 0.14),
        rgb(0.07, 0.34, 0.46),
        rgb(0.35, 0.72, 0.68),
        rgb(0.98, 0.86, 0.58),
        rgb(0.88, 0.28, 0.22)
    ];
    output image: Field<Color> = palette(ink, composition);
}
